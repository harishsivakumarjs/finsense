# Base URL for all API requests.
# Same-origin deployment (nginx/Railway/Render reverse proxy): leave as /api
# Cross-origin deployment (frontend on CDN, backend on separate domain): set to full URL
# Example: VITE_API_BASE_URL=https://api.finsense.com/api
VITE_API_BASE_URL=/api

# Dev server only — backend target for Vite proxy (not bundled into production)
# Change if your local backend runs on a different port
VITE_DEV_PROXY_TARGET=http://localhost:8001
