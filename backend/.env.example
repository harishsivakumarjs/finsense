# ═══════════════════════════════════════════════════════════════════════════
# FinSense Backend — Environment Variables Reference
#
# Copy this file to .env and fill in your values before starting the server.
# NEVER commit .env to version control — it is already in .gitignore.
#
# All variables have safe in-code defaults so the server can start without
# a .env file, but production deployments MUST override every value below.
# ═══════════════════════════════════════════════════════════════════════════


# ── Database ─────────────────────────────────────────────────────────────────
#
# PostgreSQL connection string used by SQLAlchemy and Alembic.
#
# Local development:
#   postgresql://finsense_user:finsense_pass@localhost:5432/finsense_db
#
# Render deployment:
#   Use the "Internal Database URL" shown in your Render PostgreSQL dashboard.
#   It looks like: postgresql://user:pass@dpg-xxx.internal/finsense_db
#
DATABASE_URL=postgresql://finsense_user:finsense_pass@localhost:5432/finsense_db


# ── JWT (JSON Web Tokens) ─────────────────────────────────────────────────────
#
# Secret key used to sign and verify all user session tokens.
# REQUIRED IN PRODUCTION — the default is insecure and must be replaced.
#
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
JWT_SECRET=replace-this-with-a-very-long-random-secret-key-minimum-32-chars

# Signing algorithm. HS256 is the recommended default.
JWT_ALGORITHM=HS256

# How long a token stays valid, in hours. Default: 24 (1 day).
JWT_EXPIRE_HOURS=24


# ── Firebase — Google Sign-In ─────────────────────────────────────────────────
#
# The Web API Key from your Firebase project.
# Used by POST /api/auth/google/firebase to verify Firebase ID tokens issued
# by Google Sign-In. Verification is done via the Google Identity Toolkit
# REST API (no Firebase Admin SDK or service-account JSON required):
#
#   https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=<KEY>
#
# Where to find this value:
#   Firebase Console → Project Settings → General
#   → Your apps → Web app → apiKey
#
FIREBASE_WEB_API_KEY=AIzaSy...your-firebase-web-api-key-here


# ── Email Verification (SMTP) ─────────────────────────────────────────────────
#
# SMTP settings used by services/email_service.py to send account
# verification emails after registration.
#
# DEV MODE: if SMTP_HOST or SMTP_USER is empty, the verification URL is
# printed to the server console instead of being sent. This lets you test
# the full registration → verification flow without a real mail server.
#
# Supported providers (STARTTLS on port 587):
#
#   Gmail
#     SMTP_HOST=smtp.gmail.com
#     SMTP_USER=you@gmail.com
#     SMTP_PASSWORD=<App Password>   ← not your normal Gmail password
#     Enable: Google Account → Security → 2-Step Verification
#             → App Passwords → Mail → Other → Generate
#
#   SendGrid SMTP relay
#     SMTP_HOST=smtp.sendgrid.net
#     SMTP_USER=apikey
#     SMTP_PASSWORD=<SendGrid API key>
#
#   Mailgun SMTP relay
#     SMTP_HOST=smtp.mailgun.org
#     SMTP_USER=postmaster@mg.yourdomain.com
#     SMTP_PASSWORD=<Mailgun SMTP password>
#

# Hostname of your SMTP server.
SMTP_HOST=smtp.gmail.com

# SMTP port. 587 = STARTTLS (recommended). 465 = implicit SSL.
SMTP_PORT=587

# Sender email address and SMTP login username.
SMTP_USER=noreply@yourdomain.com

# SMTP password or App Password.
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# "From:" header shown in the recipient's inbox.
# Optional — defaults to "FinSense <SMTP_USER>" when not set.
SMTP_FROM=FinSense <noreply@yourdomain.com>


# ── URLs ──────────────────────────────────────────────────────────────────────
#
# Public-facing URL of the React/Vite frontend.
# Embedded in the verification link sent to new users after registration:
#
#   {FRONTEND_URL}/verify-email?token=<secure-token>
#
# Local development:  http://localhost:5173
# Vercel deployment:  https://your-app.vercel.app
#
FRONTEND_URL=http://localhost:5173


# ── CORS ──────────────────────────────────────────────────────────────────────
#
# Comma-separated list of origins the API accepts cross-origin requests from.
# No spaces around the comma.
#
# Local:      http://localhost:5173
# Production: https://your-app.vercel.app,https://www.yourdomain.com
#
# The Flutter mobile app authenticates via JWT bearer tokens and does not
# require a CORS entry.
#
CORS_ORIGINS=http://localhost:5173


# ── Environment label ─────────────────────────────────────────────────────────
#
# Informational label for the deployment tier.
# NOT read by application code; useful for Render service configuration,
# log filtering, and distinguishing dev / staging / production output.
#
# Values: development | staging | production
#
ENVIRONMENT=development
